.title {
    font-size: 406%;
    -unity-font: resource('Assets/Fonts/RubikBurned-Regular.ttf');
    -unity-font-definition: url("project://database/Assets/Art/Fonts/MajorMonoDisplay-Regular.ttf?fileID=12800000&guid=fcb4be7ffe3bb764c8ae708cabacea77&type=3#MajorMonoDisplay-Regular");
}

.button-red {
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-color: rgb(255, 102, 102);
    -unity-font-definition: url("project://database/Assets/Art/Fonts/BungeeHairline-Regular.ttf?fileID=12800000&guid=83ac249aaefaf3b42a3de0b92f763dee&type=3#BungeeHairline-Regular");
    font-size: 30px;
    -unity-font-style: bold;
    background-size: 30% 100%;
}

.description {
    -unity-font-definition: url("project://database/Assets/Art/Fonts/BungeeHairline-Regular.ttf?fileID=12800000&guid=83ac249aaefaf3b42a3de0b92f763dee&type=3#BungeeHairline-Regular");
    font-size: 40px;
    -unity-font-style: bold;
}

.unity-tab__header-underline {
    background-color: rgb(255, 0, 0);
}

.unity-tab__header {
    margin-right: 5px;
    margin-left: 5px;
    margin-top: 0;
    margin-bottom: 0;
    color: rgb(255, 255, 255);
    background-color: rgb(0, 0, 0);
    -unity-font-definition: url("project://database/Assets/Art/Fonts/BungeeHairline-Regular.ttf?fileID=12800000&guid=83ac249aaefaf3b42a3de0b92f763dee&type=3#BungeeHairline-Regular");
    font-size: 30px;
    flex-shrink: 0;
    flex-grow: 1;
}

.unity-base-slider__text-field {
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    background-color: rgb(0, 0, 0);
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.unity-text-field__input {
    background-color: rgb(0, 0, 0);
    -unity-background-image-tint-color: rgb(255, 255, 255);
    color: rgb(255, 255, 255);
    border-left-color: rgb(255, 0, 0);
    border-right-color: rgb(255, 0, 0);
    border-top-color: rgb(255, 0, 0);
    border-bottom-color: rgb(255, 0, 0);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
}
