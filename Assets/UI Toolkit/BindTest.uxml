<!-- InputRebindUI.uxml -->
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement class="input-settings-container">
        <!-- Header -->
        <ui:VisualElement class="header">
            <ui:Label text="Input Settings" class="header-title"/>
            <ui:Label text="Click any binding to change it" class="header-subtitle"/>
        </ui:VisualElement>

        <!-- Tab Navigation -->
        <ui:VisualElement class="tab-container">
            <ui:Button name="keyboard-tab" text="Keyboard" class="tab-button active"/>
            <ui:Button name="controller-tab" text="Controller" class="tab-button"/>
        </ui:VisualElement>

        <!-- Keyboard Bindings -->
        <ui:ScrollView name="keyboard-bindings" class="bindings-container">
            <ui:VisualElement class="binding-section">
                <ui:Label text="Movement" class="section-title"/>

                <ui:VisualElement class="binding-row">
                    <ui:Label text="Move Forward" class="action-label"/>
                    <ui:Button name="forward-primary" class="key-button">W</ui:Button>
                    <ui:Button name="forward-secondary" class="key-button alt">↑</ui:Button>
                    <ui:Button name="forward-reset" class="reset-button">↺</ui:Button>
                </ui:VisualElement>

                <ui:VisualElement class="binding-row">
                    <ui:Label text="Move Backward" class="action-label"/>
                    <ui:Button name="backward-primary" class="key-button">S</ui:Button>
                    <ui:Button name="backward-secondary" class="key-button alt">↓</ui:Button>
                    <ui:Button name="backward-reset" class="reset-button">↺</ui:Button>
                </ui:VisualElement>

                <ui:VisualElement class="binding-row">
                    <ui:Label text="Move Left" class="action-label"/>
                    <ui:Button name="left-primary" class="key-button">A</ui:Button>
                    <ui:Button name="left-secondary" class="key-button alt">←</ui:Button>
                    <ui:Button name="left-reset" class="reset-button">↺</ui:Button>
                </ui:VisualElement>

                <ui:VisualElement class="binding-row">
                    <ui:Label text="Move Right" class="action-label"/>
                    <ui:Button name="right-primary" class="key-button">D</ui:Button>
                    <ui:Button name="right-secondary" class="key-button alt">→</ui:Button>
                    <ui:Button name="right-reset" class="reset-button">↺</ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="binding-section">
                <ui:Label text="Actions" class="section-title"/>

                <ui:VisualElement class="binding-row">
                    <ui:Label text="Jump" class="action-label"/>
                    <ui:Button name="jump-primary" class="key-button">Space</ui:Button>
                    <ui:Button name="jump-secondary" class="key-button alt">None</ui:Button>
                    <ui:Button name="jump-reset" class="reset-button">↺</ui:Button>
                </ui:VisualElement>

                <ui:VisualElement class="binding-row">
                    <ui:Label text="Sprint" class="action-label"/>
                    <ui:Button name="sprint-primary" class="key-button">Left Shift</ui:Button>
                    <ui:Button name="sprint-secondary" class="key-button alt">None</ui:Button>
                    <ui:Button name="sprint-reset" class="reset-button">↺</ui:Button>
                </ui:VisualElement>

                <ui:VisualElement class="binding-row">
                    <ui:Label text="Crouch" class="action-label"/>
                    <ui:Button name="crouch-primary" class="key-button">Left Ctrl</ui:Button>
                    <ui:Button name="crouch-secondary" class="key-button alt">C</ui:Button>
                    <ui:Button name="crouch-reset" class="reset-button">↺</ui:Button>
                </ui:VisualElement>

                <ui:VisualElement class="binding-row">
                    <ui:Label text="Interact" class="action-label"/>
                    <ui:Button name="interact-primary" class="key-button">E</ui:Button>
                    <ui:Button name="interact-secondary" class="key-button alt">F</ui:Button>
                    <ui:Button name="interact-reset" class="reset-button">↺</ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="binding-section">
                <ui:Label text="Combat" class="section-title"/>

                <ui:VisualElement class="binding-row">
                    <ui:Label text="Attack" class="action-label"/>
                    <ui:Button name="attack-primary" class="key-button">Mouse0</ui:Button>
                    <ui:Button name="attack-secondary" class="key-button alt">None</ui:Button>
                    <ui:Button name="attack-reset" class="reset-button">↺</ui:Button>
                </ui:VisualElement>

                <ui:VisualElement class="binding-row">
                    <ui:Label text="Block/Aim" class="action-label"/>
                    <ui:Button name="block-primary" class="key-button">Mouse1</ui:Button>
                    <ui:Button name="block-secondary" class="key-button alt">None</ui:Button>
                    <ui:Button name="block-reset" class="reset-button">↺</ui:Button>
                </ui:VisualElement>

                <ui:VisualElement class="binding-row">
                    <ui:Label text="Reload" class="action-label"/>
                    <ui:Button name="reload-primary" class="key-button">R</ui:Button>
                    <ui:Button name="reload-secondary" class="key-button alt">None</ui:Button>
                    <ui:Button name="reload-reset" class="reset-button">↺</ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:ScrollView>

        <!-- Controller Bindings -->
        <ui:ScrollView name="controller-bindings" class="bindings-container" style="display: none;">
            <ui:VisualElement class="binding-section">
                <ui:Label text="Movement" class="section-title"/>

                <ui:VisualElement class="binding-row">
                    <ui:Label text="Move" class="action-label"/>
                    <ui:Button name="controller-move" class="controller-button">Left Stick</ui:Button>
                    <ui:Button name="controller-move-reset" class="reset-button">↺</ui:Button>
                </ui:VisualElement>

                <ui:VisualElement class="binding-row">
                    <ui:Label text="Look/Camera" class="action-label"/>
                    <ui:Button name="controller-look" class="controller-button">Right Stick</ui:Button>
                    <ui:Button name="controller-look-reset" class="reset-button">↺</ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="binding-section">
                <ui:Label text="Actions" class="section-title"/>

                <ui:VisualElement class="binding-row">
                    <ui:Label text="Jump" class="action-label"/>
                    <ui:Button name="controller-jump" class="controller-button">A / ✕</ui:Button>
                    <ui:Button name="controller-jump-reset" class="reset-button">↺</ui:Button>
                </ui:VisualElement>

                <ui:VisualElement class="binding-row">
                    <ui:Label text="Sprint" class="action-label"/>
                    <ui:Button name="controller-sprint" class="controller-button">L3</ui:Button>
                    <ui:Button name="controller-sprint-reset" class="reset-button">↺</ui:Button>
                </ui:VisualElement>

                <ui:VisualElement class="binding-row">
                    <ui:Label text="Crouch" class="action-label"/>
                    <ui:Button name="controller-crouch" class="controller-button">B / ○</ui:Button>
                    <ui:Button name="controller-crouch-reset" class="reset-button">↺</ui:Button>
                </ui:VisualElement>

                <ui:VisualElement class="binding-row">
                    <ui:Label text="Interact" class="action-label"/>
                    <ui:Button name="controller-interact" class="controller-button">X / □</ui:Button>
                    <ui:Button name="controller-interact-reset" class="reset-button">↺</ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="binding-section">
                <ui:Label text="Combat" class="section-title"/>

                <ui:VisualElement class="binding-row">
                    <ui:Label text="Attack" class="action-label"/>
                    <ui:Button name="controller-attack" class="controller-button">RT</ui:Button>
                    <ui:Button name="controller-attack-reset" class="reset-button">↺</ui:Button>
                </ui:VisualElement>

                <ui:VisualElement class="binding-row">
                    <ui:Label text="Block/Aim" class="action-label"/>
                    <ui:Button name="controller-block" class="controller-button">LT</ui:Button>
                    <ui:Button name="controller-block-reset" class="reset-button">↺</ui:Button>
                </ui:VisualElement>

                <ui:VisualElement class="binding-row">
                    <ui:Label text="Reload" class="action-label"/>
                    <ui:Button name="controller-reload" class="controller-button">Y / △</ui:Button>
                    <ui:Button name="controller-reload-reset" class="reset-button">↺</ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:ScrollView>

        <!-- Waiting for Input Overlay -->
        <ui:VisualElement name="input-overlay" class="input-overlay" style="display: none;">
            <ui:VisualElement class="input-modal">
                <ui:Label text="Press any key..." class="waiting-text"/>
                <ui:Label name="conflict-warning" text="" class="conflict-text"/>
                <ui:Button name="cancel-rebind" text="Cancel (ESC)" class="cancel-button"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Bottom Actions -->
        <ui:VisualElement class="footer">
            <ui:Button name="reset-all-button" text="Reset All to Default" class="footer-button danger"/>
            <ui:Button name="save-button" text="Save Changes" class="footer-button primary"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>