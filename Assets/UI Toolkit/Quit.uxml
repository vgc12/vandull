<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/Settings.uss?fileID=7433441132597879392&amp;guid=ec9430bf6f4d1a94dafe6ea75e7f0a90&amp;type=3#Settings" />
    <ui:VisualElement name="quit-root" style="flex-grow: 1; background-color: rgb(0, 0, 0); -unity-text-align: upper-center; align-items: auto; align-content: center; justify-content: center; flex-shrink: 0; display: flex;">
        <ui:Button text="Quit to main menu" name="quit-to-menu-button" class="settings-button" style="align-self: center; width: 45%; -unity-font-style: bold; font-size: 24px;" />
        <ui:Button text="Quit to Desktop" name="quit-to-desktop-button" class="settings-button" style="align-self: center; width: 45%; -unity-font-style: bold; font-size: 24px;" />
        <ui:Button text="back" name="back-button" class="settings-button" style="align-self: center; width: 45%; -unity-font-style: bold; font-size: 24px;" />
    </ui:VisualElement>
