            <ui:VisualElement name="VisualElement" style="flex-direction: row; width: 100%; background-color: rgba(10, 10, 10, 0); padding-right: 13%; margin-top: 17px; position: relative; bottom: 0; right: 0; left: auto; top: 0; justify-content: flex-end; align-content: flex-start; align-self: flex-end; align-items: auto; flex-shrink: 0;">
                <ui:Button name="reset-button" text="Reset to Default" class="settings-button" style="padding: 10px 20px; min-width: 20px; min-height: 20px;" />
                <ui:Button name="apply-button" text="Apply" class="settings-button" style="margin-right: 5px; padding: 10px 20px; margin-left: 5px; min-width: 20px; min-height: 20px;" />
                <ui:Button name="close-button" text="Close" class="settings-button" style="padding: 10px 20px; margin-left: 5px; margin-right: 0; min-width: 20px; min-height: 20px;" />
