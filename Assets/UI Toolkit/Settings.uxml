        <ui:VisualElement name="input-overlay" class="input-overlay" style="display: none; position: absolute; right: 0; bottom: 0; left: 0; top: 0; flex-shrink: 0; align-items: center; align-self: center; justify-content: center; background-color: rgb(0, 0, 0); -unity-text-align: upper-left;">
            <ui:VisualElement class="input-modal" style="width: 30%; align-self: center; align-items: center;">
