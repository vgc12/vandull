                                                <ui:Label text="Jump" class="action-label settings-label" style="flex-grow: 0;" />
                                                <ui:VisualElement name="buttons" style="flex-grow: 1; flex-direction: row-reverse; flex-shrink: 0; padding-right: 13%;">
                                                    <ui:Button name="secondary" text="↑" class="key-button alt settings-button settings-keybind-button" style="flex-direction: column;" />
                                                    <ui:Button name="primary" text="d" class="key-button settings-button settings-keybind-button" />
                                                </ui:VisualElement>
                                            </ui:VisualElement>
                                            <ui:VisualElement name="crouch" class="binding-row" style="flex-direction: row;">
                                                <ui:Label text="Crouch" class="action-label settings-label" style="flex-grow: 0;" />
                                                <ui:VisualElement name="buttons" style="flex-grow: 1; flex-direction: row-reverse; flex-shrink: 0; padding-right: 13%;">
                                                    <ui:Button name="secondary" text="↑" class="key-button alt settings-button settings-keybind-button" style="flex-direction: column;" />
                                                    <ui:Button name="primary" text="d" class="key-button settings-button settings-keybind-button" />
                                                </ui:VisualElement>
                                            </ui:VisualElement>
                                        </ui:VisualElement>
                                        <ui:VisualElement name="actions" class="binding-section settings-label">
                                            <ui:Label text="actions" name="actions-label" parse-escape-sequences="false" class="section-title settings-header" />
                                            <ui:VisualElement name="interact" class="binding-row" style="flex-direction: row;">
                                                <ui:Label text="Interact" class="action-label settings-label" style="flex-grow: 0;" />
                                                <ui:VisualElement name="buttons" style="flex-grow: 1; flex-direction: row-reverse; flex-shrink: 0; padding-right: 13%;">
                                                    <ui:Button name="secondary" text="↑" class="key-button alt settings-button settings-keybind-button" style="flex-direction: column;" />
                                                    <ui:Button name="primary" text="d" class="key-button settings-button settings-keybind-button" />
                                                </ui:VisualElement>
                                            </ui:VisualElement>
                                        </ui:VisualElement>
                                        <ui:VisualElement name="items" class="binding-section settings-label">
                                            <ui:Label text="combat" name="combat-label" parse-escape-sequences="false" class="section-title settings-header" />
                                            <ui:VisualElement name="fire" class="binding-row" style="flex-direction: row;">
                                                <ui:Label text="Fire / Use Item" class="action-label settings-label" style="flex-grow: 0;" />
                                                <ui:VisualElement name="buttons" style="flex-grow: 1; flex-direction: row-reverse; flex-shrink: 0; padding-right: 13%;">
