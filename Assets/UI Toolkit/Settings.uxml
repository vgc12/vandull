                        </ui:ScrollView>
                    </ui:VisualElement>
                </ui:Tab>
                <ui:Tab label="Audio" name="audio-tab" style="align-items: center; flex-shrink: 0; width: 100%; max-height: 100%;">
                    <ui:VisualElement name="VisualElement" style="flex-grow: 0; flex-shrink: 0; align-items: flex-end; align-self: flex-start; max-height: 100%; width: 100%;">
                        <ui:ScrollView mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="AlwaysVisible" name="scroll-view" style="flex-grow: 0; flex-shrink: 1; flex-direction: row-reverse; flex-wrap: nowrap; max-height: none; height: 100%; width: 100%; min-width: 520px; align-self: flex-start; margin-top: 17px;">
                            <ui:Label text="Volume" name="volume-label" class="settings-header" />
                            <ui:VisualElement name="options" style="flex-grow: 1; align-items: stretch; align-self: flex-start; flex-shrink: 0; justify-content: flex-start; background-size: 520px 100%; width: 100%;">
                                <ui:VisualElement name="main" style="flex-direction: row; margin-bottom: 5px; width: 100%;">
                                    <ui:Label text="Main" name="label" class="settings-label" style="width: 150px; flex-grow: 0;" />
                                    <ui:SliderInt value="100" high-value="100" show-input-field="true" name="slider" class="settings-label" style="flex-grow: 1; flex-shrink: 0; width: auto; margin-top: 0; margin-right: 0; margin-bottom: 5px; margin-left: 0; -unity-text-align: upper-left; text-overflow: ellipsis; min-height: auto; align-self: flex-end; padding-right: 13%;" />
                                </ui:VisualElement>
                                <ui:VisualElement name="ui" style="flex-direction: row; margin-bottom: 5px; width: 100%;">
                                    <ui:Label text="UI" name="label" class="settings-label" style="width: 150px; flex-grow: 0;" />
                                    <ui:SliderInt value="100" high-value="100" show-input-field="true" name="slider" class="settings-label" style="flex-grow: 1; flex-shrink: 0; width: auto; margin-top: 0; margin-right: 0; margin-bottom: 5px; margin-left: 0; -unity-text-align: upper-left; text-overflow: ellipsis; min-height: auto; align-self: flex-end; padding-right: 13%;" />
