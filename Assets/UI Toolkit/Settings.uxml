<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/vandull-common.uss?fileID=7433441132597879392&amp;guid=a39a13c2966cff748b648d6b872b5878&amp;type=3#vandull-common" />
    <Style src="project://database/Assets/UI%20Toolkit/Settings.uss?fileID=7433441132597879392&amp;guid=ec9430bf6f4d1a94dafe6ea75e7f0a90&amp;type=3#Settings" />
    <ui:VisualElement name="settings-root" style="flex-grow: 1; padding: 20px; -unity-font-definition: url(&quot;project://database/Assets/Art/Fonts/BungeeHairline-Regular.ttf?fileID=12800000&amp;guid=83ac249aaefaf3b42a3de0b92f763dee&amp;type=3#BungeeHairline-Regular&quot;); font-size: 17px; -unity-font-style: bold; background-color: rgb(0, 0, 0); display: flex;">
        <ui:VisualElement name="settings-container" style="flex-grow: 1; flex-shrink: 0; height: 100%; align-items: center; align-content: flex-end; align-self: center; justify-content: center; width: 100%; color: rgb(0, 0, 0); background-color: rgb(14, 14, 14);">
            <ui:TabView name="settings-tabs" style="flex-grow: 1; align-items: flex-start; height: auto; max-height: 80%; flex-shrink: 0; width: 100%; background-size: 100% 80%; background-color: rgba(10, 10, 10, 0); -unity-text-align: upper-left; align-self: flex-start;">
                <ui:Tab label="Controls" name="controls-tab" style="flex-grow: 0; width: 100%; min-width: auto; flex-direction: column; align-items: center; align-content: flex-start; align-self: auto; flex-shrink: 0; max-height: 100%; background-color: rgba(0, 0, 0, 0);">
                    <ui:VisualElement name="VisualElement" style="flex-grow: 0; flex-shrink: 0; align-items: flex-end; align-self: flex-start; max-height: 100%; width: 100%;">
                        <ui:ScrollView mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="AlwaysVisible" name="scroll-view" style="flex-grow: 0; flex-shrink: 1; flex-direction: row-reverse; flex-wrap: nowrap; max-height: none; height: 100%; width: 100%; min-width: 520px; align-self: flex-start;">
                            <ui:VisualElement name="options" style="flex-grow: 1; align-items: stretch; align-self: flex-start; flex-shrink: 0; justify-content: flex-start; background-size: 520px 100%; width: 100%;">
                                <ui:Label text="MOUSE SETTINGS" name="label" class="settings-header" style="-unity-font-style: bold; margin-bottom: 15px;" />
                                <ui:VisualElement name="sensitivity" style="flex-direction: row; margin-bottom: 5px; width: 100%;">
                                    <ui:Label text="Sensitivity" name="label" class="settings-label" style="width: 150px; flex-grow: 0;" />
                                    <ui:Slider name="slider" high-value="10" low-value="0.1" value="5" show-input-field="true" style="width: auto; align-content: flex-start; align-self: flex-end; flex-grow: 1; padding-right: 13%; flex-direction: row; margin-right: 0; margin-left: 0;" />
                                </ui:VisualElement>
                                <ui:VisualElement name="invert-y" style="margin-bottom: 10px;">
                                    <ui:Toggle name="toggle" label="Invert Y-Axis" class="settings-label" />
                                </ui:VisualElement>
                                <ui:VisualElement name="invert-x" style="margin-bottom: 10px;">
                                    <ui:Toggle name="toggle" label="Invert X-Axis" class="settings-label" style="flex-grow: 0;" />
                                </ui:VisualElement>
                                <ui:VisualElement name="toggle-options" style="flex-grow: 1;">
                                    <ui:Label text="Toggle Options" name="label" class="settings-header" style="-unity-font-style: bold; margin-bottom: 15px;" />
                                    <ui:VisualElement name="toggle-crouch" style="margin-bottom: 10px;">
                                        <ui:Toggle name="toggle" label="Toggle Crouch" value="false" class="settings-label" />
                                    </ui:VisualElement>
                                    <ui:VisualElement name="toggle-sprint" style="margin-bottom: 10px;">
                                        <ui:Toggle name="toggle" label="Toggle Sprint" class="settings-label" />
                                    </ui:VisualElement>
                                    <ui:VisualElement name="toggle-aim" style="margin-bottom: 10px;">
                                        <ui:Toggle name="toggle" label="Toggle Aim" class="settings-label" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:TabView name="binds-tab-view" style="display: flex;">
                                <ui:Tab label="Keyboard" name="keyboard-binds-tab" style="flex-shrink: 0; flex-grow: 1;">
                                    <ui:ScrollView name="keyboard-bindings" class="bindings-container" style="flex-shrink: 0; flex-grow: 1;">
                                        <ui:VisualElement name="movement" class="binding-section settings-label">
                                            <ui:Label text="Movement" class="section-title settings-header" />
                                            <ui:VisualElement name="move-forward" class="binding-row" style="flex-direction: row;">
                                                <ui:Label text="Move Forward" class="action-label settings-label" style="flex-grow: 0;" />
                                                <ui:VisualElement name="buttons" style="flex-grow: 1; flex-direction: row-reverse; flex-shrink: 0; padding-right: 13%;">
                                                    <ui:Button name="secondary" text="↑" class="key-button alt settings-button settings-keybind-button" style="flex-direction: column;" />
                                                    <ui:Button name="primary" text="d" class="key-button settings-button settings-keybind-button" />
                                                </ui:VisualElement>
                                            </ui:VisualElement>
                                            <ui:VisualElement name="move-backward" class="binding-row" style="flex-direction: row;">
                                                <ui:Label text="Move Backward" class="action-label settings-label" style="flex-grow: 0;" />
                                                <ui:VisualElement name="buttons" style="flex-grow: 1; flex-direction: row-reverse; flex-shrink: 0; padding-right: 13%;">
