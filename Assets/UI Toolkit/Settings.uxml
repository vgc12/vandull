                                    <ui:SliderInt value="100" high-value="100" show-input-field="true" name="slider" class="settings-label" style="flex-grow: 1; flex-shrink: 0; width: auto; margin-top: 0; margin-right: 0; margin-bottom: 5px; margin-left: 0; -unity-text-align: upper-left; text-overflow: ellipsis; min-height: auto; align-self: flex-end; padding-right: 13%;" />
                                </ui:VisualElement>
                                <ui:VisualElement name="ambient" style="flex-direction: row; margin-bottom: 5px; width: 100%;">
                                    <ui:Label text="ambient" name="label" class="settings-label" style="width: 150px; flex-grow: 0;" />
                                    <ui:SliderInt value="100" high-value="100" show-input-field="true" name="slider" class="settings-label" style="flex-grow: 1; flex-shrink: 0; width: auto; margin-top: 0; margin-right: 0; margin-bottom: 5px; margin-left: 0; -unity-text-align: upper-left; text-overflow: ellipsis; min-height: auto; align-self: flex-end; padding-right: 13%;" />
