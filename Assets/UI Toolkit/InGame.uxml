<ui:UXML xmlns:ui="UnityEngine.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/InGame.uss?fileID=7433441132597879392&amp;guid=26adf465b5f0c73468afb0dca5b7fd2a&amp;type=3#InGame" />
    <ui:VisualElement name="in-game-root" style="flex-grow: 1; flex-direction: row; display: flex;">
        <ui:ProgressBar value="100" name="health-bar" class="health-bar" style="width: 23%; flex-direction: column-reverse; -unity-background-image-tint-color: rgb(255, 255, 255);" />
        <ui:VisualElement name="crosshair" class="crosshair">
            <ui:VisualElement class="crosshair-line crosshair-top" />
            <ui:VisualElement class="crosshair-line crosshair-right" />
            <ui:VisualElement class="crosshair-line crosshair-bottom" />
            <ui:VisualElement class="crosshair-line crosshair-left" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
