<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/vandull-common.uss?fileID=7433441132597879392&amp;guid=a39a13c2966cff748b648d6b872b5878&amp;type=3#vandull-common" />
    <Style src="project://database/Assets/UI%20Toolkit/Settings.uss?fileID=7433441132597879392&amp;guid=ec9430bf6f4d1a94dafe6ea75e7f0a90&amp;type=3#Settings" />
    <ui:VisualElement name="mission-over-root" style="flex-grow: 1; display: flex;">
        <ui:VisualElement style="flex-grow: 1; background-color: rgb(0, 0, 0); -unity-text-align: upper-left; align-items: center;">
            <ui:Label text="Mission Success" name="mission-status-label" class="large-font title" style="-unity-text-align: middle-center; background-color: rgb(0, 0, 0); -unity-font-style: italic; padding-top: 2%;" />
            <ui:Label text="Something" name="mission-description-label" class="description settings-label" style="-unity-text-align: lower-center; height: 30%; flex-direction: column; color: rgb(255, 255, 255); -unity-font-style: bold; flex-grow: 0;" />
            <ui:Button text="Restart" name="restart-button" class="button-red settings-button" style="width: 33%; align-self: center; margin-top: 35px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
