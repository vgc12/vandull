.unity-tab__header:selected {
    margin-right: 5px;
    margin-left: 5px;
    margin-top: 0;
    margin-bottom: 0;
    color: rgb(255, 255, 255);
    background-color: rgb(153, 0, 0);
    -unity-font-definition: url("project://database/Assets/Art/Fonts/BungeeHairline-Regular.ttf?fileID=12800000&guid=83ac249aaefaf3b42a3de0b92f763dee&type=3#BungeeHairline-Regular");
    font-size: 30px;
    align-items: flex-start;
    align-self: flex-start;
    align-content: flex-start;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
}

.unity-tab__header {
    margin-right: 5px;
    margin-left: 5px;
    margin-top: 0;
    margin-bottom: 0;
    color: rgb(255, 255, 255);
    background-color: rgb(0, 0, 0);
    -unity-font-definition: url("project://database/Assets/Art/Fonts/BungeeHairline-Regular.ttf?fileID=12800000&guid=83ac249aaefaf3b42a3de0b92f763dee&type=3#BungeeHairline-Regular");
    font-size: 30px;
    align-items: flex-start;
    align-self: flex-start;
    align-content: flex-start;
}

.unity-slider .unity-text-field {
    width: 45px;
    height: 45px;
    flex-shrink: 0;
}

:root {
}

.unity-toggle__input {
    align-items: flex-end;
    align-self: flex-end;
    flex-shrink: 1;
    flex-direction: row;
    padding-left: 45%;
}

.unity-tab__content-container {
    flex-grow: 0;
    flex-shrink: 0;
    width: 82%;
    align-items: center;
    justify-content: flex-start;
    min-height: auto;
    overflow: hidden;
    max-height: 100%;
    align-self: auto;
    flex-direction: row;
}

.unity-toggle__checkmark {
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    background-color: rgb(0, 0, 0);
    border-left-color: rgb(255, 0, 0);
    border-right-color: rgb(255, 0, 0);
    border-top-color: rgb(255, 0, 0);
    border-bottom-color: rgb(255, 0, 0);
    flex-shrink: 0;
    min-height: 45px;
    min-width: 45px;
    align-self: auto;
    align-items: auto;
    align-content: auto;
}

.settings-label {
    margin-right: 0;
    color: rgb(255, 255, 255);
    font-size: 17px;
    text-overflow: ellipsis;
}

.settings-button {
    color: rgb(255, 255, 255);
    border-left-color: rgb(255, 0, 0);
    border-right-color: rgb(255, 0, 0);
    border-top-color: rgb(255, 0, 0);
    border-bottom-color: rgb(255, 0, 0);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    font-size: 17px;
    align-self: flex-start;
    align-items: flex-end;
    background-color: rgb(10, 10, 10);
    min-height: 45px;
    min-width: 45px;
}

.settings-text-field {
    color: rgb(255, 255, 255);
}

.settings-header {
    margin-right: 30px;
    color: rgb(255, 255, 255);
    font-size: 24px;
}

.settings-keybind-button {
    color: rgb(255, 255, 255);
    border-left-color: rgb(255, 0, 0);
    border-right-color: rgb(255, 0, 0);
    border-top-color: rgb(255, 0, 0);
    border-bottom-color: rgb(255, 0, 0);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    font-size: 17px;
    align-self: flex-start;
    align-items: flex-end;
    background-color: rgb(10, 10, 10);
    min-height: 45px;
    min-width: 45px;
    max-width: 150px;
}

.unity-toggle__label {
    flex-grow: 0;
    flex-shrink: 0;
}

.unity-tab-view__content-container {
    flex-grow: 0;
    flex-shrink: 0;
    width: 100%;
    align-items: center;
    justify-content: flex-start;
    min-height: auto;
    overflow: hidden;
    max-height: 100%;
    align-self: auto;
    flex-direction: row;
}
